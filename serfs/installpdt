#!/bin/bash
#inkVerbSerf! verb.ink
# Compatibility: pdt is now winstonpress

usagenotes="This installs Winston Press (was pdt-news / installpdt)"
usageformat="installpdt [ domain.tld ] [ single|network - optional ] [ dbase - optional ] [ dbuser - optional ] [ dbpassword - optional ]"
usageexample="installpdt inkisaverb.com"
hierarchy=( primary )
vsetnames=( "Domain" )
vsettypes=( isDomain )
voptnames=( "Mode" "Database" "Database user" "Database password" )
vopttypes=( isChoice isSQLDatabasename isSQLDatabasename isSQLDatabasename )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=(  )
prerequesite=(  )
usedby=(  )
useserfs=( installwinstonpress )
useconfigs=(  )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi
if [ -e "/opt/verb/mods/installpdt.replace" ]; then . /opt/verb/mods/installpdt.replace; return 0; fi

/usr/bin/echo "installpdt is now installwinstonpress (ink install winstonpress)."
exec /opt/verb/serfs/installwinstonpress "$@"
