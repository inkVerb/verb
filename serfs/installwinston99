#!/bin/bash
#inkVerbSerf! verb.ink

# This downloads and installs Winston 99 as a vapp, same shape as WordPress
## App lives in www/vapps/winston99.DOMAIN.TLD
## Front is the domain you pass: html/DOMAIN.TLD -> that vapp (adddomain if missing)
## Config file is config.php
## Does not invent a 99. subdomain. ink install winston99 -d 99.write.pink lives at 99.write.pink.

# All options after the domain are optional, but are sequential

# How to use:
## ./installwinston99 [ domain.tld ] [ dbase ] [ dbuser ] [ dbpassword ]
## ./installwinston99 [ domain.tld ]
## ./installwinston99 [ 99.domain.tld ]

usagenotes="This downloads and installs Winston 99 to a specified domain"
usageformat="installwinston99 [ domain.tld ] [ dbase - optional ] [ dbuser - optional ] [ dbpassword - optional ]"
usageexample="installwinston99 inkisaverb.com
installwinston99 99.write.pink
installwinston99 inkisaverb.com somedatabase somedbuser somedbpassword"
hierarchy=( primary )
vsetnames=( "Domain" )
vsettypes=( isDomain )
voptnames=( "Database" "Database user" "Database password" )
vopttypes=( isSQLDatabasename isSQLDatabasename isSQLDatabasename )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=(  )
prerequesite=(  )
usedby=(  )
useserfs=( inkget adddomain )
useconfigs=( servertype )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi # Must have for proper usage to not run the full serf
if [ -e "/opt/verb/mods/installwinston99.replace" ]; then . /opt/verb/mods/installwinston99.replace; return 0; fi # Replaces this script
if [ -e "/opt/verb/mods/installwinston99.before" ]; then . /opt/verb/mods/installwinston99.before; fi # Precedes this script


cVappName=winston99

domain=$1
dBase=$2
dBaseUser=$3
dBPassword=$4
cleanName=$(/usr/bin/echo ${domain} | /usr/bin/sed -e 's/\.//g')

if [ -z ${1} ]; then
/bin/echo "You must designate a domain. Read the How to use. Can't continue."
exit 8; fi

. /opt/verb/donjon/vappinstall.sh
if ! vappinst_clear_partial \
  "/opt/verb/conf/vapps/vapp.${cVappName}.${domain}" \
  "/srv/www/vapps/${cVappName}.${domain}" \
  "/srv/www/vapps/${cVappName}.${domain}/config.php"; then
/bin/echo "This is already installed."
exit 0; fi

vappinst_begin

if [ ! -d "/srv/www/domains/${domain}" ]; then
vappinst_adddomain_if_missing "${domain}"
e="$?"; [[ "$e" = "0" ]] || exit "$e"
fi

cd /srv/www/vapps || exit 6
/opt/verb/serfs/inkget ${cVappName} check
e="$?"; [[ "$e" = "0" ]] || exit "$e"
vappinst_note dir "/srv/www/vapps/${cVappName}"

if [ -z "${dBPassword}" ]; then
dBPassword=$(/usr/bin/pwgen -s -1 10); fi
if [ -z "${dBase}" ]; then
dBase=w99$(/usr/bin/echo ${cleanName} | /usr/bin/cut -c1-20)$(/usr/bin/pwgen -s -1 6); fi
if [ -z "${dBaseUser}" ]; then
dBaseUser=${dBase}; fi

/bin/mv ${cVappName} ${cVappName}.${domain}
vappinst_note dir "/srv/www/vapps/${cVappName}.${domain}"
vappinst_html_link "${domain}" "/srv/www/vapps/${cVappName}.${domain}"
e="$?"; [[ "$e" = "0" ]] || exit "$e"
vappinst_symlink "/srv/vip/_webapps/${cVappName}.${domain}" "/srv/www/vapps/${cVappName}.${domain}"
/bin/chown -R www:www /srv/www/html/${domain}; wait
/bin/chown -R www:www /srv/www/vapps/${cVappName}.${domain}; wait

/usr/bin/mariadb --defaults-extra-file=/opt/verb/conf/sql/mysqlboss.cnf -e "
CREATE DATABASE ${dBase};
GRANT ALL PRIVILEGES ON ${dBase}.* TO '${dBaseUser}'@'localhost' IDENTIFIED BY '${dBPassword}';
FLUSH PRIVILEGES;"
e="$?"; [[ "$e" = "0" ]] || exit "$e"
vappinst_note mysql "${dBase}" "${dBaseUser}"

if [ -f /srv/www/vapps/${cVappName}.${domain}/sql/schema.sql ]; then
  /usr/bin/mariadb --defaults-extra-file=/opt/verb/conf/sql/mysqlboss.cnf ${dBase} < /srv/www/vapps/${cVappName}.${domain}/sql/schema.sql
fi

/usr/bin/mkdir -p /opt/verb/conf/vapps
/bin/echo "appDBase=${dBase}
appDDBUsr=${dBaseUser}
appDDBPass=${dBPassword}
appEngine=mariadb
appPubHost=${domain}" > /opt/verb/conf/vapps/vapp.${cVappName}.${domain}
vappinst_note conf "/opt/verb/conf/vapps/vapp.${cVappName}.${domain}"

# SysAdmin config (PHP return array). Host is after https:// only.
# allow_create_super true so the first Superintendent can be created at /install.php; set false after.
/usr/bin/cat > /srv/www/vapps/${cVappName}.${domain}/config.php <<EOF
<?php
return [
    'configured' => true,
    'allow_create_super' => true,
    'host' => '${domain}',
    'site_title' => 'Winston 99',
    'db' => [
        'host' => '127.0.0.1',
        'port' => 3306,
        'name' => '${dBase}',
        'user' => '${dBaseUser}',
        'pass' => '${dBPassword}',
        'charset' => 'utf8mb4',
    ],
    'mail' => [
        'transport' => 'mail',
        'from' => 'noreply@${domain}',
        'from_name' => 'Winston 99',
        'smtp_host' => '127.0.0.1',
        'smtp_port' => 587,
        'smtp_user' => '',
        'smtp_pass' => '',
        'smtp_secure' => 'tls',
    ],
    'github' => 'https://github.com/JesseSteele/Winston99.git',
    'github_branch' => 'master',
    'oauth' => [
        'google' => ['id' => '', 'secret' => ''],
        'apple'  => ['id' => '', 'secret' => ''],
        'github' => ['id' => '', 'secret' => ''],
    ],
];
EOF
/bin/chown www:www /srv/www/vapps/${cVappName}.${domain}/config.php
/bin/chmod 640 /srv/www/vapps/${cVappName}.${domain}/config.php
/usr/bin/mkdir -p /etc/winston99
/bin/ln -sfn /srv/www/vapps/${cVappName}.${domain}/config.php /etc/winston99/${domain}
/opt/verb/serfs/setvappconfig "vapp.${cVappName}.${domain}" "/srv/www/vapps/${cVappName}.${domain}/config.php"

/bin/chown -R www:www /srv/www/vapps/${cVappName}.${domain}
. /opt/verb/conf/servertype
if [ ${ServerType} = "lemp" ]; then
  /usr/bin/systemctl restart nginx
elif [ ${ServerType} = "lamp" ]; then
  /usr/bin/systemctl restart httpd
elif [ ${ServerType} = "laemp" ]; then
  /usr/bin/systemctl restart httpd
  /usr/bin/systemctl restart nginx
fi

vappinst_commit
/usr/bin/echo "These are setup:

Database: ${dBase}
Database user: ${dBaseUser}
Database password: ${dBPassword}
Public host: ${domain}

Go to https://${domain}/install.php to create the first Superintendent.
Then set allow_create_super to false in config.php.
"



if [ -e "/opt/verb/mods/installwinston99.after" ]; then . /opt/verb/mods/installwinston99.after; fi # Follows this script
