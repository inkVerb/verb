#!/bin/bash
#inkVerbSerf! verb.ink

# Rewrite BIND-safe DKIM TXT only where this host actually sends mail.
## Native verb zones: only nameURI (the mail host), and only if that zone has MX or smtp/mail.
## Hosted zones/: only domains whose zone already has MX or smtp/mail, and a live key.
## Does not walk every verb TLD. Does not create keys for emailTLDURI.

# How to use:
## ./updateinkdnsdkim

usagenotes="This rewrites BIND-safe DKIM TXT on the verber nameURI and hosted mail zones (MX or smtp/mail)"
usageformat="updateinkdnsdkim"
usageexample="updateinkdnsdkim"
hierarchy=( primary )
vsetnames=(  )
vsettypes=(  )
voptnames=(  )
vopttypes=(  )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=( inkdnsinstall )
prerequesite=(  )
usedby=(  )
useserfs=( newinkdkim inkdnsaddinkdkim inkdnsrefreshbind )
useconfigs=( servermailpath siteurilist inkdnsconf )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi # Must have for proper usage to not run the full serf
if [ -e "/opt/verb/mods/updateinkdnsdkim.replace" ]; then . /opt/verb/mods/updateinkdnsdkim.replace; return 0; fi # Replaces this script
if [ -e "/opt/verb/mods/updateinkdnsdkim.before" ]; then . /opt/verb/mods/updateinkdnsdkim.before; fi # Precedes this script


. /opt/verb/conf/servermailpath
. /opt/verb/conf/siteurilist

if [ "${ServerMailStatus}" != "VMAIL_SERVER" ] && [[ "${ServerMailStatus}" != "MADDY_EMAIL_"* ]]; then
  /usr/bin/echo "No mail server installed; DKIM zone update skipped."
  exit 0
fi

# Zone is a mail zone if it has MX or smtp/mail host records
zone_sends_mail() {
  local zf="$1"
  [ -f "${zf}" ] || return 1
  if /usr/bin/grep -Eq '[[:space:]]IN[[:space:]]+MX[[:space:]]' "${zf}"; then
    return 0
  fi
  if /usr/bin/grep -Eq '^(smtp|mail)\.' "${zf}"; then
    return 0
  fi
  return 1
}

has_dkim_key() {
  local domain="$1"
  if [ "${ServerMailStatus}" = "VMAIL_SERVER" ]; then
    [ -f "/etc/opendkim/keys/${domain}/inkdkim.txt" ] && return 0
  elif [[ "${ServerMailStatus}" == "MADDY_EMAIL_"* ]]; then
    [ -f "/srv/email/maddy/dkim_keys/${domain}_default.dns" ] && return 0
    for alt in /srv/email/maddy/dkim_keys/${domain}_*.dns; do
      [ -f "${alt}" ] && return 0
    done
  fi
  return 1
}

# VMAIL: only the verber mail host (nameURI) may get a missing key created
if [ "${ServerMailStatus}" = "VMAIL_SERVER" ] && [ -n "${nameURI}" ]; then
  if [ ! -f "/etc/opendkim/keys/${nameURI}/inkdkim.txt" ]; then
    /usr/bin/echo "Creating OpenDKIM keys for ${nameURI}..."
    /opt/verb/serfs/newinkdkim "${nameURI}" || true
  fi
fi

added=0
skipped=0

dkim_one() {
  local domain="$1"
  local verberflag="$2"
  if [ -n "${verberflag}" ]; then
    /opt/verb/serfs/inkdnsaddinkdkim "${domain}" verber norefresh
  else
    /opt/verb/serfs/inkdnsaddinkdkim "${domain}" norefresh
  fi
  if [ "$?" = "0" ]; then
    added=$((added + 1))
  else
    skipped=$((skipped + 1))
    /usr/bin/echo "Skipped ${domain} (no key or no zone)."
  fi
}

# Native verb zones: only nameURI, and only if it is actually a mail zone
if [ -n "${nameURI}" ]; then
  namezone="/opt/verb/conf/inkdns/inkzones/db.${nameURI}"
  if zone_sends_mail "${namezone}" && has_dkim_key "${nameURI}"; then
    dkim_one "${nameURI}" verber
  elif [ -f "${namezone}" ]; then
    skipped=$((skipped + 1))
    /usr/bin/echo "Skipped ${nameURI} (no MX/smtp/mail in zone, or no key)."
  fi
fi

# Hosted domains: only those whose zone already has MX or smtp/mail, and a live key
if [ -d /opt/verb/conf/inkdns/zones ]; then
  for zonefile in /opt/verb/conf/inkdns/zones/db.*; do
    [ -f "${zonefile}" ] || continue
    domain="$(/usr/bin/basename "${zonefile}" | /usr/bin/sed 's/^db\.//')"
    if zone_sends_mail "${zonefile}" && has_dkim_key "${domain}"; then
      dkim_one "${domain}" ""
    fi
  done
fi

if [ -f /opt/verb/conf/inkdnsconf ]; then
  . /opt/verb/conf/inkdnsconf
  if [ "${InkDNSStat}" = "INSTALLED" ] && [ -x /opt/verb/serfs/inkdnsrefreshbind ]; then
    /opt/verb/serfs/inkdnsrefreshbind || true
  fi
fi

/usr/bin/echo "inkDKIM zone update: ${added} written, ${skipped} skipped."




if [ -e "/opt/verb/mods/updateinkdnsdkim.after" ]; then . /opt/verb/mods/updateinkdnsdkim.after; fi # Follows this script
