#!/bin/bash
#inkVerbSerf! verb.ink

# This downloads and updates the Verber™ core files, including serfs and inklists
## This also runs scripts that make other changes that may affect the Verber
## Node/PHP LTS is NOT done here. That is version-gated in verb-update/update
## (and ink set serverlts / installghost). Do not hang the updater on npm.

# How to use:
## ./updateverber


usagenotes="This downloads and updates the Verber™ core files, including serfs and inklists"
usageformat="updateverber"
usageexample="updateverber"
hierarchy=( primary )
vsetnames=(  )
vsettypes=(  )
voptnames=(  )
vopttypes=(  )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=(  )
prerequesite=(  )
usedby=(  )
useserfs=(  )
useconfigs=( servernameip )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi # Must have for proper usage to not run the full serf
if [ -e "/opt/verb/mods/updateverber.replace" ]; then . /opt/verb/mods/updateverber.replace; return 0; fi # Replaces this script
if [ -e "/opt/verb/mods/updateverber.before" ]; then . /opt/verb/mods/updateverber.before; fi # Precedes this script


# Include the config
if [ -d "/opt/verb/inst" ]; then
  ## This allows updates on a -premade or -made verber
  ServerUpdateOrg="inkverb"
  ServerUpdateRepo="verb-update"
else
  ## This is for updates on a setup verber
  . /opt/verb/conf/servernameip
fi

# Download the latest checked version from GitHub
cd /opt/verb/ || exit 6
/usr/bin/git clone https://github.com/${ServerUpdateOrg}/${ServerUpdateRepo}
e="$?"
if [ "$e" != "0" ] || [ ! -f "/opt/verb/${ServerUpdateRepo}/update" ]; then
  /usr/bin/echo "Could not clone ${ServerUpdateOrg}/${ServerUpdateRepo}."
  exit 6
fi

# Run the update script (copies serfs/ink/donjon, then version patches, then prints Verno)
/bin/chmod 750 /opt/verb/${ServerUpdateRepo}/update
/opt/verb/${ServerUpdateRepo}/update
e="$?"
# update already rm -rf's itself; do not call setserverlts here

[[ "$e" = "0" ]] || exit "$e"



if [ -e "/opt/verb/mods/updateverber.after" ]; then . /opt/verb/mods/updateverber.after; fi # Follows this script
