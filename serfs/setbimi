#!/bin/bash
#inkVerbSerf! verb.ink

# This installs a BIMI SVG for a mail domain from a VIP or FTP drop
## Drop names: domain.tld.svg  (legacy domain.tld.bimi.svg still accepted)
## VIP:  /srv/vip/files/domain.tld.svg  →  /srv/www/email/bimi/domain.tld/bimi.svg
## FTP:  /srv/ftp/domain.tld.svg        →  same dest
## Public URL: https://${emailTLDURI}/domain.tld/bimi.svg
## The drop file is deleted after a successful install.
## inkMail writes the VIP drop, then runs: ink set bimi -p vip -d domain.tld
## scp/ftp drops are installed only by this CLI (SysAdmin).

# How to use:
## ./setbimi [ domain.tld ] [ ftp | vip ]

usagenotes="This moves a dropped BIMI SVG into /srv/www/email/bimi/domain.tld/bimi.svg and adds the DNS TXT"
usageformat="setbimi [ domain.tld ] [ ftp | vip ]"
usageexample="setbimi inkisaverb.com vip
setbimi inkisaverb.com ftp"
hierarchy=( primary )
vsetnames=( "Domain" "Drop path" )
vsettypes=( isDomain isChoice )
voptnames=(  )
vopttypes=(  )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=(  )
prerequesite=(  )
usedby=( inkMail )
useserfs=( inkdnsaddbimi )
useconfigs=( siteurilist )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi # Must have for proper usage to not run the full serf
if [ -e "/opt/verb/mods/setbimi.replace" ]; then . /opt/verb/mods/setbimi.replace; return 0; fi # Replaces this script
if [ -e "/opt/verb/mods/setbimi.before" ]; then . /opt/verb/mods/setbimi.before; fi # Precedes this script


domain="$1"
drop="$2"

if [ -z "${domain}" ] || [ -z "${drop}" ]; then
  /usr/bin/echo "Domain and drop path (ftp|vip) required."
  exit 5
fi

. /opt/verb/conf/siteurilist

case "${drop}" in
  vip)
    src="/srv/vip/files/${domain}.svg"
    srclegacy="/srv/vip/files/${domain}.bimi.svg"
    ;;
  ftp)
    src="/srv/ftp/${domain}.svg"
    srclegacy="/srv/ftp/${domain}.bimi.svg"
    ;;
  *)
    /usr/bin/echo "Drop path must be ftp or vip."
    exit 5
    ;;
esac

if [ ! -f "${src}" ] && [ -f "${srclegacy}" ]; then
  src="${srclegacy}"
fi
if [ ! -f "${src}" ]; then
  /usr/bin/echo "No BIMI SVG at ${src}"
  exit 8
fi
if ! /usr/bin/grep -qi '<svg' "${src}"; then
  /usr/bin/echo "Not an SVG: ${src}"
  exit 8
fi

. /opt/verb/donjon/bimi-web.sh

destDir="/srv/www/email/bimi/${domain}"
dest="${destDir}/bimi.svg"
/usr/bin/mkdir -p "${destDir}"
/usr/bin/cp "${src}" "${dest}"
e="$?"; [[ "$e" = "0" ]] || exit "6"
/usr/bin/chown www:www "${dest}"
/usr/bin/chmod 644 "${dest}"

# Drop is spent once it is installed
/usr/bin/rm -f "${src}" "${srclegacy}"

/opt/verb/serfs/inkdnsaddbimi "${domain}"
e="$?"; [[ "$e" = "0" ]] || exit "$e"

/usr/bin/echo "BIMI logo at https://${emailTLDURI}/${domain}/bimi.svg (from ${drop})"




if [ -e "/opt/verb/mods/setbimi.after" ]; then . /opt/verb/mods/setbimi.after; fi # Follows this script
