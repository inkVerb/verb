#!/bin/bash
#inkVerbSerf! verb.ink

# This adds (or replaces) the inkDKIM TXT on an existing DNS zone file
## OpenDKIM (vmail): /etc/opendkim/keys/DOMAIN/inkdkim.txt → inkdkim._domainkey
## Maddy: /srv/email/maddy/dkim_keys/DOMAIN_default.dns → default._domainkey
## TXT character-strings are split at 255 octets (BIND dns_rdata_fromtext)

# How to use:
## ./inkdnsaddinkdkim [ domain.tld ]
## ./inkdnsaddinkdkim [ domain.tld ] verber
## ./inkdnsaddinkdkim [ domain.tld ] [ verber ] [ norefresh ]

usagenotes="This adds or replaces the inkDKIM TXT in the inkDNS zone file (BIND-safe 255-octet splits)"
usageformat="inkdnsaddinkdkim [ domain.tld ] [ verber - verb TLD zone ] [ norefresh - skip bind reload ]"
usageexample="inkdnsaddinkdkim inkisaverb.com
inkdnsaddinkdkim NAME.verb.email verber
inkdnsaddinkdkim NAME.verb.email verber norefresh"
hierarchy=( tertiary adddomain )
vsetnames=( "Domain" )
vsettypes=( isDomain )
voptnames=( "verber" "norefresh" )
vopttypes=( string_match string_match )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=( inkdnsinstall )
prerequesite=( newinkdkim )
usedby=( newdomainshell installinkvmail installmaddymail installpostfixvmail updateinkdnsdkim )
useserfs=( inkdnsserial inkdnsrefreshbind )
useconfigs=( servernameip servermailpath )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi # Must have for proper usage to not run the full serf
if [ -e "/opt/verb/mods/inkdnsaddinkdkim.replace" ]; then . /opt/verb/mods/inkdnsaddinkdkim.replace; return 0; fi # Replaces this script
if [ -e "/opt/verb/mods/inkdnsaddinkdkim.before" ]; then . /opt/verb/mods/inkdnsaddinkdkim.before; fi # Precedes this script


dnsDomain="$1"
if [ -z "${dnsDomain}" ]; then
  /usr/bin/echo "Domain is required."
  exit 5
fi
shift
zonedir="zones"
verberny=""
norefresh=""
while [ -n "$1" ]; do
  case "$1" in
    verber) zonedir="inkzones"; verberny=" verber" ;;
    norefresh) norefresh="true" ;;
  esac
  shift
done

# Include the configs
. /opt/verb/conf/servernameip
. /opt/verb/conf/servermailpath
. /opt/verb/donjon/inkdns-dkim-txt.sh

zonefile="/opt/verb/conf/inkdns/${zonedir}/db.${dnsDomain}"
if [ ! -f "${zonefile}" ]; then
  /usr/bin/echo "No zone file for ${dnsDomain} in ${zonedir}."
  exit 8
fi

# Locate the live key material
dkimfile=""
dkimowner=""
if [ "${ServerMailStatus}" = "VMAIL_SERVER" ]; then
  dkimfile="/etc/opendkim/keys/${dnsDomain}/inkdkim.txt"
  dkimowner="inkdkim._domainkey.${dnsDomain}."
elif [[ "${ServerMailStatus}" == "MADDY_EMAIL_"* ]]; then
  dkimfile="/srv/email/maddy/dkim_keys/${dnsDomain}_default.dns"
  dkimowner="default._domainkey.${dnsDomain}."
  if [ ! -f "${dkimfile}" ]; then
    dkimwait=0
    while [ "${dkimwait}" -lt 15 ]; do
      if [ -f "${dkimfile}" ]; then break; fi
      # any selector for this domain
      for alt in /srv/email/maddy/dkim_keys/${dnsDomain}_*.dns; do
        if [ -f "${alt}" ]; then
          dkimfile="${alt}"
          dkimsel="$(/usr/bin/basename "${alt}" | /usr/bin/sed "s/^${dnsDomain}_//;s/\.dns$//")"
          dkimowner="${dkimsel}._domainkey.${dnsDomain}."
          break
        fi
      done
      [ -f "${dkimfile}" ] && break
      /usr/bin/sleep 1
      dkimwait=$((dkimwait + 1))
    done
  fi
else
  /usr/bin/echo "No mail server (Maddy or Postfix vmail) is installed. Nothing to add."
  exit 0
fi

if [ ! -f "${dkimfile}" ]; then
  /usr/bin/echo "DKIM key does not exist for ${dnsDomain}."
  exit 6
fi

dkimval="$(inkdns_dkim_value_from_file "${dkimfile}")"
if [ -z "${dkimval}" ]; then
  /usr/bin/echo "Could not read a DKIM TXT value from ${dkimfile}."
  exit 6
fi
dkimrdata="$(inkdns_txt_rdata "${dkimval}")"

# Drop any previous DKIM block (old "; DKIM key" and current "; inkDKIM key")
/usr/bin/sed -i "/; inkDKIM key ${dnsDomain}/,/;; End inkDKIM key ${dnsDomain}/d" "${zonefile}"
/usr/bin/sed -i "/; DKIM key ${dnsDomain}/,/;; End DKIM key ${dnsDomain}/d" "${zonefile}"
/usr/bin/sed -i "/inkdkim\._domainkey/d" "${zonefile}"
/usr/bin/sed -i "/default\._domainkey/d" "${zonefile}"

# Write the BIND-safe record
/usr/bin/printf '%s\n' "; inkDKIM key ${dnsDomain}" >> "${zonefile}"
/usr/bin/printf '%s\tIN  TXT\t%s\n' "${dkimowner}" "${dkimrdata}" >> "${zonefile}"
/usr/bin/printf '%s\n' ";; End inkDKIM key ${dnsDomain}" >> "${zonefile}"

# Serial
/opt/verb/serfs/inkdnsserial ${dnsDomain}${verberny}
e="$?"; [[ "$e" = "0" ]] || exit "$e"

# Refresh zones
if [ "${norefresh}" != "true" ] && [ -f "/opt/verb/conf/inkdnsconf" ]; then
  . /opt/verb/conf/inkdnsconf
  if [ "${InkDNSStat}" = "INSTALLED" ]; then
    /opt/verb/serfs/inkdnsrefreshbind
    e="$?"; [[ "$e" = "0" ]] || exit "$e"
  fi
fi

/usr/bin/echo "The DKIM key has been added to the ${dnsDomain} DNS zone file."




if [ -e "/opt/verb/mods/inkdnsaddinkdkim.after" ]; then . /opt/verb/mods/inkdnsaddinkdkim.after; fi # Follows this script
