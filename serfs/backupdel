#!/bin/bash
#inkVerbSerf! verb.ink

# This delets all backups from the server and their web-accessible symlinks

# How to use:
## ./backupdel


usagenotes="This delets all backups from the server and their web-accessible symlinks"
usageformat="backupdel"
usageexample="backupdel"
hierarchy=( primary )
vsetnames=(  )
vsettypes=(  )
voptnames=(  )
vopttypes=(  )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=(  )
prerequesite=(  )
usedby=(  )
useserfs=(  )
useconfigs=( servernameip )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi # Must have for proper usage to not run the full serf
if [ -e "/opt/verb/mods/backupdel.replace" ]; then . /opt/verb/mods/backupdel.replace; return 0; fi # Replaces this script
if [ -e "/opt/verb/mods/backupdel.before" ]; then . /opt/verb/mods/backupdel.before; fi # Precedes this script


# Include the configs
. /opt/verb/conf/servernameip

for f in /srv/www/vip/*.vbak; do
  [ -e "${f}" ] || continue
  if [ -L "${f}" ]; then
    /bin/rm -f "$(/usr/bin/readlink -f "${f}")"
  fi
  /bin/rm -f "${f}"
done
for d in /mnt/hdd/vip /mnt/ssd/vip; do
  /bin/rm -f "${d}"/*.vbak 2>/dev/null || true
done
if [ -d /opt/verb/conf/inkdrive ]; then
  for cfg in /opt/verb/conf/inkdrive/hdd.* /opt/verb/conf/inkdrive/ssd.*; do
    [ -f "${cfg}" ] || continue
    n=$(/usr/bin/basename "${cfg}")
    n="${n#hdd.}"
    n="${n#ssd.}"
    /bin/rm -f "/mnt/${n}/vip"/*.vbak 2>/dev/null || true
  done
fi
. /opt/verb/donjon/servedl.sh
sdir=$(servedl_dir)
/bin/rm -f "${sdir}"/*.vbak "${sdir}"/*.vbak.sql 2>/dev/null || true





if [ -e "/opt/verb/mods/backupdel.after" ]; then . /opt/verb/mods/backupdel.after; fi # Follows this script
