#!/bin/bash
#inkVerbSerf! verb.ink

# This downloads and installs badAd (golang branch) as a vapp on a hosted domain
## One network per domain. Machine name: www/vapps/badad.DOMAIN.TLD
## Front: DOMAIN (web) and api.DOMAIN (API engine, second localhost port)
## Dedicated-server scale.

# How to use:
## ./installbadad [ domain.tld ] [ dbase ] [ dbuser ] [ dbpassword ]
## ./installbadad [ domain.tld ]

usagenotes="This downloads and installs badAd to a specified domain (web + api subdomain)"
usageformat="installbadad [ domain.tld ] [ dbase - optional ] [ dbuser - optional ] [ dbpassword - optional ]"
usageexample="installbadad inkisaverb.com
installbadad inkisaverb.com somedb someuser somepass"
hierarchy=( primary )
vsetnames=( "Domain" )
vsettypes=( isDomain )
voptnames=( "Database" "Database user" "Database password" )
vopttypes=( isSQLDatabasename isSQLDatabasename isSQLDatabasename )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=(  )
prerequesite=(  )
usedby=(  )
useserfs=( inkget adddomain addsubdomain pgsqlnewdb setnginxvappproxy )
useconfigs=( servertype )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi # Must have for proper usage to not run the full serf
if [ -e "/opt/verb/mods/installbadad.replace" ]; then . /opt/verb/mods/installbadad.replace; return 0; fi # Replaces this script
if [ -e "/opt/verb/mods/installbadad.before" ]; then . /opt/verb/mods/installbadad.before; fi # Precedes this script


cVappName=badad

domain=$1
dBase=$2
dBaseUser=$3
dBPassword=$4
cleanName=$(/usr/bin/echo ${domain} | /usr/bin/sed -e 's/\.//g')
svcName="badad-$(/usr/bin/echo ${domain} | /usr/bin/tr '.' '-')"
appPort=$(( 9300 + $(/usr/bin/printf '%s' "${domain}" | /usr/bin/cksum | /usr/bin/awk '{print $1 % 600}') ))
apiPort=$(( appPort + 1 ))

if [ -z ${1} ]; then
/bin/echo "You must designate a domain. Read the How to use. Can't continue."
exit 8; fi
if [ -f /opt/verb/conf/vapps/vapp.${cVappName}.${domain} ]; then
/bin/echo "This is already installed."
exit 0; fi
if [ -d /srv/www/vapps/${cVappName}.${domain} ]; then
/bin/echo "That badAd site already exists in the system. If it isn't working, look deeper on the server. For now, doing nothing."
exit 0; fi

. /opt/verb/conf/servertype
if [ ${ServerType} = "lamp" ]; then
  /usr/bin/echo "badAd needs Nginx (LEMP or LAEMP)."; exit 8
fi

if [ ! -d "/srv/www/domains/${domain}" ]; then
/opt/verb/serfs/adddomain ${domain}
wait
fi
if [ ! -d "/srv/www/domains/api.${domain}" ]; then
/opt/verb/serfs/addsubdomain api ${domain}
wait
fi

# api.DOMAIN must be an active Nginx vhost, with cert coverage:
# DONE_CB (wildcard already applied by addsubdomain) OR DONE_LE with api.DOMAIN listed in cli-ini
apicert="/opt/verb/conf/inkcert/cli-ini/siteinkcert.${domain}"
apini="/opt/verb/conf/inkcert/cli-ini/cli.${domain}.ini"
ngenabled=""
for p in \
  "/etc/nginx/sites-enabled/api.${domain}.conf" \
  "/opt/verb/conf/webserver/sites-enabled/nginx/api.${domain}.conf" \
  "/opt/verb/conf/webserver/sites-available/nginx/api.${domain}.conf"
do
  if [ -f "$p" ] || [ -L "$p" ]; then ngenabled="$p"; break; fi
done
if [ -z "${ngenabled}" ]; then
  /usr/bin/echo "api.${domain} is not an active Nginx site. Add the subdomain and enable it first."
  exit 8
fi
if [ -f "${apicert}" ]; then
  if /usr/bin/grep -Fq "InkCerted=DONE_CB" "${apicert}"; then
    /usr/bin/echo "api.${domain}: covered by Certbot wildcard (DONE_CB)."
  elif /usr/bin/grep -Fq "InkCerted=DONE_LE" "${apicert}"; then
    if [ -f "${apini}" ] && /usr/bin/grep -Fq "api.${domain}" "${apini}"; then
      /usr/bin/echo "api.${domain}: listed on the Letsencrypt cert (DONE_LE). Refresh with inkcertdole if the live cert does not yet include it."
    else
      /usr/bin/echo "api.${domain} is not listed in ${apini}. Add it (addsubdomain does this) then inkcertdole ${domain}."
      exit 8
    fi
  else
    /usr/bin/echo "FYI: ${domain} does not have DONE_CB or DONE_LE yet. api.${domain} is served; obtain certs before production."
  fi
fi


cd /srv/www/vapps || exit 6
/opt/verb/serfs/inkget ${cVappName} check
e="$?"; [[ "$e" = "0" ]] || exit "$e"

if [ -z "${dBPassword}" ]; then
dBPassword=$(/usr/bin/pwgen -s -1 16); fi
if [ -z "${dBase}" ]; then
dBase=badad$(/usr/bin/echo ${cleanName} | /usr/bin/cut -c1-18)$(/usr/bin/pwgen -s -1 6); fi
if [ -z "${dBaseUser}" ]; then
dBaseUser=${dBase}; fi

/bin/mv ${cVappName} ${cVappName}.${domain}

if ! /usr/bin/command -v go >/dev/null 2>&1; then
  /usr/bin/echo "Go is not installed. It should have been installed by make-verber (lamp/lemp/laemp)."
  exit 6
fi
cd /srv/www/vapps/${cVappName}.${domain} || exit 6
/usr/bin/mkdir -p bin
/usr/bin/go build -o bin/badad ./cmd/badad
e="$?"; [[ "$e" = "0" ]] || exit "$e"

/opt/verb/serfs/pgsqlnewdb ${dBase} ${dBaseUser} ${dBPassword}
e="$?"; [[ "$e" = "0" ]] || exit "$e"

if [ -f sql/schema.sql ]; then
  export PGPASSWORD="${dBPassword}"
  /usr/bin/psql -h 127.0.0.1 -U ${dBaseUser} -d ${dBase} -f sql/schema.sql
  e="$?"; unset PGPASSWORD
  [[ "$e" = "0" ]] || exit "$e"
fi

/usr/bin/mkdir -p /etc/badad/wallet
/usr/bin/chown www:www /etc/badad /etc/badad/wallet
/usr/bin/chmod 0750 /etc/badad
/usr/bin/chmod 0700 /etc/badad/wallet

cfg="/opt/verb/conf/vapps/${cVappName}.${domain}.config"
/usr/bin/mkdir -p /opt/verb/conf/vapps
/usr/bin/cat > "${cfg}" <<EOF
web_bind=127.0.0.1
web_port=${appPort}
web_url=https://${domain}
api_bind=127.0.0.1
api_port=${apiPort}
api_url=https://api.${domain}
db_host=127.0.0.1
db_port=5432
db_name=${dBase}
db_user=${dBaseUser}
db_pass=${dBPassword}
mail_transport=off
mail_from=noreply@${domain}
wallet_dir=/etc/badad/wallet
EOF
/usr/bin/chmod 640 "${cfg}"
/usr/bin/chown root:www "${cfg}"
/bin/ln -sfn "${cfg}" /etc/badad/${domain}

/bin/echo "appDBase=${dBase}
appDDBUsr=${dBaseUser}
appDDBPass=${dBPassword}
appEngine=postgres
appPort=${appPort}
appApiPort=${apiPort}
appConfig=${cfg}
appService=${svcName}
appEtcLink=/etc/badad/${domain}" > /opt/verb/conf/vapps/vapp.${cVappName}.${domain}

/opt/verb/serfs/setvappconfig "vapp.${cVappName}.${domain}" "${cfg}"

/usr/bin/cat > /etc/systemd/system/${svcName}.service <<EOF
[Unit]
Description=badAd (${domain})
After=network.target postgresql.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/srv/www/vapps/${cVappName}.${domain}
ExecStart=/srv/www/vapps/${cVappName}.${domain}/bin/badad
Restart=on-failure
Environment=BADAD_CONFIG=${cfg}

[Install]
WantedBy=multi-user.target
EOF

/bin/chown -R www:www /srv/www/vapps/${cVappName}.${domain}
/usr/bin/systemctl daemon-reload
/usr/bin/systemctl enable --now ${svcName}.service

/opt/verb/serfs/setnginxvappproxy ${domain} 127.0.0.1:${appPort}
e="$?"; [[ "$e" = "0" ]] || exit "$e"
/opt/verb/serfs/setnginxvappproxy api.${domain} 127.0.0.1:${apiPort}
e="$?"; [[ "$e" = "0" ]] || exit "$e"

/usr/bin/echo "These are setup:

Database: ${dBase}
Database user: ${dBaseUser}
Database password: ${dBPassword}
Web: 127.0.0.1:${appPort}  https://${domain}/
API: 127.0.0.1:${apiPort}  https://api.${domain}/

Payment keys stay in ${cfg} (SysAdmin). One network per domain.
"



if [ -e "/opt/verb/mods/installbadad.after" ]; then . /opt/verb/mods/installbadad.after; fi # Follows this script
