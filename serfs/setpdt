#!/bin/bash
#inkVerbSerf! verb.ink
# Compatibility: setpdt is now setwinstonpress

usagenotes="This modifies Winston Press settings (was setpdt)"
usageformat="setpdt [ domain.tld ] [ key=value ] ..."
usageexample="setpdt inkisaverb.com mode=network"
hierarchy=( primary )
vsetnames=( "Domain" )
vsettypes=( isDomain )
voptnames=(  )
vopttypes=(  )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=(  )
prerequesite=( installwinstonpress )
usedby=(  )
useserfs=( setwinstonpress )
useconfigs=(  )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi
if [ -e "/opt/verb/mods/setpdt.replace" ]; then . /opt/verb/mods/setpdt.replace; return 0; fi

exec /opt/verb/serfs/setwinstonpress "$@"
