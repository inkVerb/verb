#!/bin/bash
#inkVerbSerf! verb.ink

# This displays the inkDKIM TXT for a domain, split for BIND (255-octet strings)

# How to use:
## ./showinkdkim [ domain.tld ]

usagenotes="This displays the inkDKIM TXT for a domain so it can be added to DNS"
usageformat="showinkdkim [ domain.tld ]"
usageexample="showinkdkim
showinkdkim [ domain.tld ]"
hierarchy=( primary )
vsetnames=( "Domain" )
vsettypes=( isDomain )
voptnames=(  )
vopttypes=(  )
voptflags=(  )
voptflagpurpose=(  )
dependencyinstall=(  )
prerequesite=(  )
usedby=(  )
useserfs=(  )
useconfigs=( servermailpath )
if [ -n "$infoINKonly" ] && [ "$infoINKonly" = "true" ]; then return 0; fi # Must have for proper usage to not run the full serf
if [ -e "/opt/verb/mods/showinkdkim.replace" ]; then . /opt/verb/mods/showinkdkim.replace; return 0; fi # Replaces this script
if [ -e "/opt/verb/mods/showinkdkim.before" ]; then . /opt/verb/mods/showinkdkim.before; fi # Precedes this script


. /opt/verb/conf/servermailpath
. /opt/verb/donjon/inkdns-dkim-txt.sh

domain=$1
if [ -z "${domain}" ]; then
  /usr/bin/echo "Domain is required."
  exit 5
fi

dkimfile=""
dkimowner=""
if [ "${ServerMailStatus}" = "VMAIL_SERVER" ]; then
  dkimfile="/etc/opendkim/keys/${domain}/inkdkim.txt"
  dkimowner="inkdkim._domainkey.${domain}."
elif [ "${ServerMailStatus}" = "MADDY_EMAIL_SERVER" ] || [[ "${ServerMailStatus}" == "MADDY_EMAIL_"* ]]; then
  dkimfile="/srv/email/maddy/dkim_keys/${domain}_default.dns"
  dkimowner="default._domainkey.${domain}."
else
  /usr/bin/echo "No mail server installed."
  exit 0
fi

if [ ! -f "${dkimfile}" ]; then
  /usr/bin/echo "No DKIM key file for ${domain}."
  exit 6
fi

dkimval="$(inkdns_dkim_value_from_file "${dkimfile}")"
if [ -z "${dkimval}" ]; then
  /usr/bin/echo "Could not read a DKIM TXT value from ${dkimfile}."
  exit 6
fi
/usr/bin/printf '%s\tIN  TXT\t%s\n' "${dkimowner}" "$(inkdns_txt_rdata "${dkimval}")"




if [ -e "/opt/verb/mods/showinkdkim.after" ]; then . /opt/verb/mods/showinkdkim.after; fi # Follows this script
